{
  "name": "jsfn-run",
  "private": true,
  "type": "module",
  "prettier": "@cloud-cli/prettier-config",
  "scripts": {
    "ci": "npm i --no-fund --no-audit && npm run build",
    "build": "tsc --noEmit && vite build --assetsInlineLimit=0",
    "lint": "eslint main.ts src/catalog.ts *.mjs tests/**/*.ts",
    "test": "playwright test",
    "dev": "vite",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@cloud-cli/prettier-config": "^1.0.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/markdown-it": "^13.0.7",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^4.5.13"
  },
  "dependencies": {
    "@homebots/parse-html": "^1.1.1",
    "es-eventdelegate": "^1.0.0",
    "markdown-it": "^14.0.0"
  }
}
